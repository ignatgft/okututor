# ==============================================================================
# OkuTutor — Шаблон переменных окружения для Production (Dokploy / VPS)
# Все переменные в этом файле строго проверяются ProdEnvValidator при старте!
# ==============================================================================

SPRING_PROFILES_ACTIVE=prod,jsonlog
OKUTUTOR_ENV=production

# --- База данных PostgreSQL (Neon / Managed / Docker) ---
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_NAME=okututor_prod
DB_USER=okututor_app
DB_PASSWORD=GENERATE_STRONG_RANDOM_DB_PASSWORD_HERE

# --- Redis ---
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
APP_RATE_LIMIT_USE_REDIS=true

# --- JWT и безопасность (ProdEnvValidator: длина >= 32 символа, запрещены dev-дефолты) ---
JWT_SECRET=GENERATE_AT_LEAST_32_CHAR_RANDOM_HEX_OR_BASE64_SECRET_KEY!
APP_SEED_ENABLED=false
APP_API_DOCS_ENABLED=false

# --- Telegram Alert Webhook Secret ---
TG_ALERT_SECRET=GENERATE_RANDOM_TG_ALERT_SECRET_HERE

# --- URLs и CORS (ProdEnvValidator: строго https, запрещен wildcard *) ---
FRONTEND_URL=https://okututor.kg
APP_CORS_ORIGINS=https://okututor.kg,https://www.okututor.kg

# --- Почта (Resend SMTP / AWS SES) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
RESEND_API_KEY=re_YOUR_PRODUCTION_RESEND_API_KEY
APP_MAIL_ENABLED=true
MAIL_FROM=OkuTutor <no-reply@okututor.kg>

# --- Хранилище файлов (Cloudflare R2 или S3) ---
STORAGE_PROVIDER=r2
APP_STORAGE_PUBLIC_BASE=https://media.okututor.kg
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=okututor-prod-media
R2_PUBLIC_URL=https://media.okututor.kg

# --- Google OAuth (Опционально) ---
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
