# ==============================================================================
# OkuTutor — Шаблон переменных окружения для локального запуска (Docker Compose)
# Без реальных секретов. Скопируйте в .env перед запуском.
# ==============================================================================

# База данных PostgreSQL (контейнер postgres)
POSTGRES_DB=okututor
POSTGRES_USER=okututor
POSTGRES_PASSWORD=okututor
DB_HOST=postgres
DB_PORT=5432
DB_NAME=okututor
DB_USER=okututor
DB_PASSWORD=okututor

# Redis (кэш, rate limiting)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=

# Почта Mailpit (локальный SMTP + Web UI на http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_ENABLED=true
MAIL_FROM=Okututor <no-reply@okututor.local>

# JWT и безопасность
JWT_SECRET=dev-secret-key-okututor-free-mvp-must-be-at-least-32-characters!
APP_SEED_ENABLED=true
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled

# Фронтенд и CORS
FRONTEND_URL=http://localhost:8081
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:80

# Мониторинг Prometheus & Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
