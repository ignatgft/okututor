# Okututor Frontend — Environment Variables
# ЕДИНСТВЕННЫЙ шаблон для всех окружений. Скопируй в .env для dev, в Dokploy/Cloudflare Pages — выставь prod значения.
# Файл .env в .gitignore (только .env.example коммитится).
#
# Copy to .env for local development: cp .env.example .env

# Backend API URL
# Dev: http://localhost:8080 (прямой backend)
# Prod (Cloudflare Pages / Dokploy): /api (nginx проксирует на backend)
VITE_API_URL=http://localhost:8080

# App environment: development | staging | production
VITE_APP_ENV=development

# Production API mode (из frontend/.env.production — перенесено сюда, не удалять)
# В dev не нужен, в prod: api
# VITE_API_MODE=api

# Mock mode was removed; keep this false so the app uses the live backend.
# Search requires a running okututor-backend (see README "Search" section).
VITE_MOCK_MODE=false

# Google OAuth URL (optional — defaults to /oauth2/authorization/google)
# VITE_GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# Google Analytics 4 (optional). Set the Measurement ID (G-XXXXXXX) to enable
# analytics on PUBLIC pages only. Private areas (admin/student/tutor) are never tracked.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
