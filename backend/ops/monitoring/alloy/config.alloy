// Grafana Alloy — сбор логов + OTel
// Логи backend (JSON) → Loki, traces → Tempo, metrics → Prometheus

logging { level = "info" }

loki.source.kubernetes { }
loki.write "default" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

// Docker logs → Loki (структурированные)
loki.source.docker "backend" {
  host = "unix:///var/run/docker.sock"
  targets = [{ __path__ = "/var/lib/docker/containers/*/*-json.log" }]
  forward_to = [loki.process.backend.receiver]
}
loki.process "backend" {
  stage.json {
    expressions = { level = "level", trace_id = "trace_id", request_id = "requestId", route = "route", status = "status", message = "message" }
  }
  stage.labels {
    values = { app = "okututor-backend", environment = "production", level = "level" }
  }
  // высококардинальные поля — в structured_metadata, не лейблы
  stage.structured_metadata { values = { trace_id = "trace_id", request_id = "request_id" } }
  forward_to = [loki.write.default.receiver]
}

otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}
otelcol.exporter.otlp "tempo" {
  client { endpoint = "tempo:4317" }
}
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}
prometheus.remote_write "default" {
  endpoint { url = "http://prometheus:9090/api/v1/write" }
}
