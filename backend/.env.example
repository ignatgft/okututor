# ============================================================================
# Okututor Backend — шаблон окружения.
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. cp .env.example .env
#   2. заполнить значения (для dev достаточно дефолтов ниже + ключи с CHANGE_ME)
#   3. НИКОГДА не коммитить .env — он в .gitignore; в репозитории только шаблон
#
# Приоритет источников: OS environment > .env > application-{profile}.yml
# ============================================================================

# ========================= APPLICATION =========================
# Активный профиль окружения: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ========================= DATABASE (PostgreSQL) =========================
# Подключение основного хранилища. Обязательно во всех окружениях.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=okututor
DB_USER=okututor
# Пароль БД. В prod — длинный случайный, задаётся на сервере.
DB_PASSWORD=CHANGE_ME

# ========================= JWT =========================
# Секрет подписи access/refresh токенов (HS256/HS512).
# Требования: >= 32 символов, криптографически случайный.
# Пример генерации: openssl rand -base64 64
# В prod отсутствие/слабый секрет = приложение НЕ стартует (ProdEnvValidator).
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET_0123456789abcdef

# Время жизни токенов (в секундах), используются RefreshTokenService/JwtService.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ========================= GOOGLE OAUTH2 =========================
# Креды из Google Cloud Console -> Credentials -> OAuth 2.0 Client.
# Пустые значения = Google-вход отключён (локальная разработка).
# Redirect URI в консоли: {FRONTEND_URL}/login/oauth2/code/google или backend callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================= FRONTEND / CORS =========================
# URL фронтенда: redirect после OAuth, ссылки в письмах.
FRONTEND_URL=http://localhost:5173
# Разрешённые origins через запятую. В prod — только реальные домены (https).
APP_CORS_ORIGINS=http://localhost:5173

# ========================= LIVEKIT (видеоуроки) =========================
# WS-адрес сервера и креды для подписи временных access-токенов участников.
# Секрет НИКОГДА не отдаётся фронту — токены генерирует backend.
#
# РЕКОМЕНДАЦИЯ: для локальной разработки используйте dev-проект LiveKit Cloud
# (wss://<project>.livekit.cloud) — схема wss:// работает из коробки и не
# требует self-hosted установки. Self-hosted на localhost говорит по ws://
# (LIVEKIT_WS_URL=ws://localhost:7880) — wss:// к localhost не подключится.
LIVEKIT_WS_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ========================= MAIL (SMTP) =========================
# APP_MAIL_ENABLED=false -> письма пишутся в лог (dev-заглушка);
# true -> реальная отправка через SMTP (Resend/Mailpit/провайдер).
APP_MAIL_ENABLED=true
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
# Пароль/API-key SMTP. В prod — секрет почтового провайдера.
RESEND_API_KEY=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Адрес отправителя: "Okututor <no-reply@ваш-домен>".
MAIL_FROM=Okututor <noreply@goidaai.ru>

# ========================= REDIS (rate limit, опционально) =========================
REDIS_HOST=localhost
REDIS_PORT=6379
# Пусто = без пароля (локальный Redis). В prod — обязательно с паролем.
REDIS_PASSWORD=

# ========================= SEED (bootstrap админов) =========================
# Создание обязательных админов из SeedData. По умолчанию выключено.
# Включайте только для начальной инициализации: APP_SEED_ENABLED=true
APP_SEED_ENABLED=false
# Пароли админов — минимум 12 символов, задаются ТОЛЬКО через ENV (без хардкод-фолбэков).
SEED_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_12_PLUS
SEED_SUPPORT_PASSWORD=CHANGE_ME_LONG_RANDOM_12_PLUS

# ========================= MEDIA / STORAGE =========================
# local = файлы на диске; r2 = Cloudflare R2 + CDN.
STORAGE_PROVIDER=local
MEDIA_IMAGE_FORMAT=webp
MEDIA_AVATAR_MAX_WIDTH=512
MEDIA_AVATAR_MAX_HEIGHT=512
MEDIA_AVATAR_QUALITY=82
MEDIA_COURSE_COVER_MAX_WIDTH=1600
MEDIA_COURSE_COVER_MAX_HEIGHT=900
MEDIA_COURSE_COVER_QUALITY=80
MEDIA_PROFILE_MAX_WIDTH=1200
MEDIA_PROFILE_MAX_HEIGHT=1200
MEDIA_PROFILE_QUALITY=82
MEDIA_MAX_PIXELS=25000000
MEDIA_ORPHAN_CLEANUP_ENABLED=false
MEDIA_ORPHAN_GRACE_HOURS=24

# Cloudflare R2 (заполняется при STORAGE_PROVIDER=r2):
# R2_ENDPOINT — полный S3-совместимый endpoint, напр. https://ACCOUNT_ID.r2.cloudflarestorage.com
# Если задан R2_ENDPOINT, он приоритетнее R2_ACCOUNT_ID
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичная база CDN-домена бакета (напр. https://media.okututor.com или https://pub-xxx.r2.dev):
R2_PUBLIC_BASE_URL=

# ========================= ACTUATOR =========================
# В prod наружу открыт только /actuator/health (см. application-prod.yml).
# Доступ к чувствительным эндпоинтам при необходимости — через reverse-proxy ACL,
# а не через публикацию в Spring.
ACTUATOR_EXPOSURE=health

# ========================= PROD / INFRA (Dokploy, Cloudflare, Neon) =========================
# Доверенные прокси (Dokploy reverse proxy / Cloudflare). В prod — список IP.
APP_TRUSTED_PROXIES=
# Окружение: development | production (используется в логах, алертах).
OKUTUTOR_ENV=production
# OpenTelemetry / Tempo (опционально, если включен трейсинг).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_TRACING_ENABLED=false
OTEL_SAMPLING=0.1
# Health check Redis (в prod с Neon без Redis — false).
MANAGEMENT_HEALTH_REDIS_ENABLED=false
