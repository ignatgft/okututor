# Copy to .env and fill — never commit real .env (Dokploy: paste into Environment Variables)
# One Dokploy Application `okututor-monitoring` with compose path `monitoring/docker-compose.yml` runs everything.

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_32+
GRAFANA_DOMAIN=grafana.okututor.kg
GRAFANA_ROOT_URL=https://grafana.okututor.kg
GRAFANA_EXTERNAL_URL=https://grafana.okututor.kg
GRAFANA_PORT=3000

# Telegram — create bot via @BotFather, get token
TELEGRAM_BOT_TOKEN=123456789:ABC_your_token_here
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_ENVIRONMENT=production

# Prometheus / Loki retention (configurable)
PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090
LOKI_RETENTION_PERIOD=168h
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://alertmanager:9093

# Backend scrape target — how Prometheus reaches OkuTutor API /actuator/prometheus
# If backend is separate Dokploy Application on same host/network:
#   BACKEND_HOST=host.docker.internal or private IP/hostname, or https://api.okututor.kg
# Grafana protects prometheus endpoint via auth; set if scrape uses BasicAuth:
# PROMETHEUS_BACKEND_USER=prom
# PROMETHEUS_BACKEND_PASS=CHANGE_ME
BACKEND_SCRAPE_TARGET=backend:8080
# Alternative: full URL via metrics_path override in prometheus.yml
