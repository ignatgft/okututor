{
  "title": "Сервер — состояние (CPU / RAM / Диск / Сеть)",
  "tags": ["node", "system", "ru"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU — загрузка",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
    },
    {
      "type": "timeseries",
      "title": "RAM — использование",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Диск — занято / всего",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"} - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}", "refId": "A", "legendFormat": "занято {{mountpoint}}"},
        {"expr": "node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}", "refId": "B", "legendFormat": "всего {{mountpoint}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "type": "timeseries",
      "title": "Сеть — трафик",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total[5m])", "refId": "A", "legendFormat": "входящий {{device}}"},
        {"expr": "rate(node_network_transmit_bytes_total[5m])", "refId": "B", "legendFormat": "исходящий {{device}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "binBps"}}
    },
    {
      "type": "stat",
      "title": "Аптайм",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [{"expr": "time() - node_boot_time_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "stat",
      "title": "Нагрузка LA 5m",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
      "targets": [{"expr": "node_load5", "refId": "A"}]
    }
  ]
}
