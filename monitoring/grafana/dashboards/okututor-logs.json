{
  "title": "OkuTutor — Logs",
  "uid": "okututor-logs",
  "tags": ["okututor", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 201,
      "type": "logs",
      "title": "ERROR — {job=\"docker\", level=\"ERROR\"}",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{level=\"ERROR\"} | json | line_format \"{{.timestamp}} {{.level}} {{.logger}} {{.message}} req={{.requestId}}\"", "refId": "A" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 202,
      "type": "logs",
      "title": "WARN — {level=\"WARN\"}",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{level=\"WARN\"} | json", "refId": "A" }],
      "options": { "showTime": true },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 }
    },
    {
      "id": 203,
      "type": "logs",
      "title": "INFO — {job=\"docker\"} (filter in Explore)",
      "description": "Explore: {job=\"docker\", service=\"okututor-backend\"} |= \"\"  or  {level=\"INFO\"}",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"docker\"} | json | line_format \"{{.level}} {{.logger}} {{.message}}\"", "refId": "A" }],
      "options": { "showTime": true },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 204,
      "type": "text",
      "title": "",
      "options": { "content": "Tip: Use Grafana Explore → Loki → `{job=\"docker\", level=\"ERROR\"}` или `{service=\"okututor-backend\"} |= \"search\"` для фильтрации по `requestId`, `logger`, `message`. Labels: `job`, `container`, `service`, `level`, `environment` — low cardinality, без PII.", "mode": "markdown", "code": { "language": "plaintext", "showLineNumbers": false } },
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 32 }
    }
  ]
}
